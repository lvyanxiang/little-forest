.header {
  background: #1E3A1E;
}

.title-wrap {
  height: 88rpx;
  padding: 0 48rpx 40rpx;
  display: flex;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #F5EFE0;
  line-height: 1.2;
}

.brand-wrap {
  padding: 24rpx 48rpx 40rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logo {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.en {
  font-size: 20rpx;
  color: #8FAF6B;
  letter-spacing: 0.2em;
  line-height: 1.3;
}

.zh {
  font-size: 40rpx;
  font-weight: 600;
  color: #F5EFE0;
  line-height: 1.2;
}

.sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8FAF6B;
}
