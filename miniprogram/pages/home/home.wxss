.page {
  min-height: 100vh;
  background: #FDFAF3;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #3D5C2D 0%, #1E3A1E 100%);
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(30, 58, 30, 0.2) 0%, rgba(30, 58, 30, 0.72) 100%);
}

.hero-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 48rpx;
}

.hero-en {
  display: block;
  font-size: 22rpx;
  color: #8FAF6B;
  letter-spacing: 0.15em;
  margin-bottom: 8rpx;
}

.hero-title {
  display: flex;
  flex-direction: column;
  font-size: 48rpx;
  font-weight: 600;
  color: #F5EFE0;
  line-height: 1.35;
}

.cta-wrap {
  padding: 40rpx 48rpx;
}

.cta {
  height: 96rpx;
  border-radius: 32rpx;
  background: #1E3A1E;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.cta:active {
  opacity: 0.88;
}

.cta-icon {
  width: 36rpx;
  height: 36rpx;
}

.cta-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #F5EFE0;
}

.section {
  padding: 0 48rpx 48rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E3A1E;
  margin-bottom: 32rpx;
}

.section-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.section-row .section-title {
  margin-bottom: 0;
}

.section-sub {
  font-size: 24rpx;
  color: #5C7A3A;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.feature-card {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  background: #F5EFE0;
  border: 1rpx solid #D8CFC4;
  border-radius: 32rpx;
  padding: 32rpx;
}

.feature-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1E3A1E;
  margin-bottom: 8rpx;
}

.feature-desc {
  display: block;
  font-size: 22rpx;
  color: #8A7558;
  line-height: 1.6;
}

.section-bleed {
  padding-left: 0;
  padding-right: 0;
}

.section-bleed .section-row {
  padding: 0 48rpx;
}

.h-scroll {
  width: 100%;
}

.book-row {
  display: inline-flex;
  flex-direction: row;
  padding: 0 48rpx;
  box-sizing: content-box;
}

.book {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  flex-shrink: 0;
  width: 220rpx;
  height: 288rpx;
  margin-right: 24rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.book:last-child {
  margin-right: 0;
}

.book-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #F5EFE0;
  line-height: 1.3;
}

.book-author {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(245, 239, 224, 0.6);
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.event-card {
  display: flex;
  gap: 32rpx;
  padding: 32rpx;
  background: #F5EFE0;
  border: 1rpx solid #D8CFC4;
  border-radius: 32rpx;
}

.event-date {
  min-width: 104rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: #1E3A1E;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.event-month,
.event-week {
  font-size: 20rpx;
  color: #8FAF6B;
}

.event-day {
  font-size: 36rpx;
  font-weight: 600;
  color: #F5EFE0;
  line-height: 1.1;
  margin: 4rpx 0;
}

.event-body {
  flex: 1;
  min-width: 0;
}

.event-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.event-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E3A1E;
}

.event-tag {
  font-size: 20rpx;
  color: #5C7A3A;
  background: #D8CFC4;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.event-desc {
  font-size: 24rpx;
  color: #8A7558;
  line-height: 1.6;
}

.store {
  margin: 0 48rpx;
  border: 1rpx solid #D8CFC4;
  border-radius: 32rpx;
  overflow: hidden;
}

.store-cover {
  position: relative;
  height: 256rpx;
}

.store-img {
  width: 100%;
  height: 100%;
  display: block;
}

.store-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(30, 58, 30, 0.35);
}

.store-name {
  position: absolute;
  left: 32rpx;
  bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #F5EFE0;
}

.store-info {
  padding: 32rpx;
  background: #F5EFE0;
}

.store-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.store-row:last-child {
  margin-bottom: 0;
}

.store-ico {
  font-size: 28rpx;
  line-height: 1.4;
}

.store-text {
  font-size: 24rpx;
  color: #8A7558;
  line-height: 1.6;
}
