<view class="page" style="padding-bottom: {{pageBottom}}px;">
  <view class="hero" style="height: {{heroHeight}}px;">
    <image class="hero-img" src="/assets/hero.jpg" mode="aspectFill" />
    <view class="hero-mask"></view>
    <app-header overlay="{{true}}" />
    <view class="hero-copy">
      <text class="hero-en">LITTLE FOREST BOOKSTORE</text>
      <view class="hero-title serif">
        <text>在书与自然之间</text>
        <text>找到片刻宁静</text>
      </view>
    </view>
  </view>

  <view class="cta-wrap">
    <view class="cta" bindtap="onReserve">
      <image class="cta-icon" src="/assets/icon-reserve-light.svg" mode="aspectFit" />
      <text class="cta-text serif">立即预约到店</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title serif">书店特色</text>
    <view class="feature-grid">
      <view wx:for="{{features}}" wx:key="title" class="feature-cell">
        <view class="feature-card">
          <text class="feature-icon">{{item.icon}}</text>
          <text class="feature-title serif">{{item.title}}</text>
          <text class="feature-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section section-bleed">
    <view class="section-row">
      <text class="section-title serif">本月精选书单</text>
      <text class="section-sub">10月 · 秋日阅读</text>
    </view>
    <scroll-view class="h-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="book-row">
        <view wx:for="{{books}}" wx:key="title" class="book" style="background: {{item.color}};">
          <text class="book-title serif">{{item.title}}</text>
          <text class="book-author">{{item.author}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <text class="section-title serif">近期活动</text>
    <view class="event-list">
      <view wx:for="{{events}}" wx:key="title" class="event-card">
        <view class="event-date">
          <text class="event-month">{{item.month}}</text>
          <text class="event-day serif">{{item.day}}</text>
          <text class="event-week">{{item.weekday}}</text>
        </view>
        <view class="event-body">
          <view class="event-top">
            <text class="event-title serif">{{item.title}}</text>
            <text class="event-tag">{{item.tag}}</text>
          </view>
          <text class="event-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="store">
    <view class="store-cover">
      <image class="store-img" src="/assets/store.jpg" mode="aspectFill" />
      <view class="store-mask"></view>
      <text class="store-name serif">{{store.name}}</text>
    </view>
    <view class="store-info">
      <view class="store-row link" bindtap="onOpenMap">
        <text class="store-ico">📍</text>
        <text class="store-text">{{store.address}}</text>
        <text class="store-nav">导航</text>
      </view>
      <view class="store-row">
        <text class="store-ico">🕘</text>
        <text class="store-text">{{store.hours}}</text>
      </view>
      <view class="store-row link" bindtap="onCall">
        <text class="store-ico">📞</text>
        <text class="store-text">{{store.phoneDisplay}}</text>
      </view>
      <view class="store-tips">
        <text class="store-tips-title">到店说明：</text>
        <text class="store-tip">{{homeNoticeText}}</text>
      </view>
    </view>
  </view>
</view>
