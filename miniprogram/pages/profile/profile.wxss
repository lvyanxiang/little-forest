.page {
  min-height: 100vh;
  background: #FDFAF3;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.user-card {
  margin: 40rpx 48rpx 40rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #1E3A1E;
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #2D5016;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #F5EFE0;
}

.user-phone {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8FAF6B;
}

.user-count {
  text-align: right;
}

.count-num {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #F5EFE0;
}

.count-label {
  font-size: 24rpx;
  color: #8FAF6B;
}

.section {
  padding: 0 48rpx 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E3A1E;
  margin-bottom: 24rpx;
}

.empty {
  border-radius: 32rpx;
  padding: 80rpx 0;
  background: #F5EFE0;
  border: 1rpx dashed #C4B49A;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8A7558;
}

.up-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.up-card {
  background: #F5EFE0;
  border: 1rpx solid #C4B49A;
  border-radius: 32rpx;
  padding: 32rpx;
}

.up-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5C7A3A;
}

.status {
  font-size: 24rpx;
  font-weight: 500;
  color: #5C7A3A;
}

.up-date {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E3A1E;
}

.up-slot {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #8A7558;
}

.cancel-btn {
  font-size: 24rpx;
  color: #8A7558;
  border: 1rpx solid #D8CFC4;
  background: #FDFAF3;
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
}

.up-foot {
  padding-top: 24rpx;
  border-top: 1rpx solid #D8CFC4;
  display: flex;
  gap: 64rpx;
}

.meta-k {
  display: block;
  font-size: 20rpx;
  color: #8A7558;
  margin-bottom: 4rpx;
}

.meta-v {
  font-size: 24rpx;
  color: #1E3A1E;
}

.past-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.past-card {
  background: #F5EFE0;
  border: 1rpx solid #D8CFC4;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  opacity: 0.7;
}

.past-date {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #8A7558;
}

.past-slot {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #C4B49A;
}

.past-tag {
  font-size: 24rpx;
  color: #8A7558;
  background: #D8CFC4;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(30, 58, 30, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}

.dialog {
  width: 100%;
  background: #FDFAF3;
  border-radius: 48rpx;
  padding: 48rpx;
  box-sizing: border-box;
}

.dialog-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #1E3A1E;
  margin-bottom: 16rpx;
}

.dialog-desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #8A7558;
  margin-bottom: 48rpx;
}

.dialog-actions {
  display: flex;
  gap: 24rpx;
}

.dialog-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.dialog-btn.ghost {
  background: #F5EFE0;
  border: 1rpx solid #C4B49A;
  color: #1E3A1E;
}

.dialog-btn.solid {
  background: #1E3A1E;
  color: #F5EFE0;
}
