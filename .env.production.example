# Copy to .env.production on the server; do not commit real credentials.
# Verify the existing PostgreSQL network and container name in 1Panel.
DB_NETWORK=1panel-network
DB_HOST=replace-with-postgres-container-or-alias
DB_PORT=5432
DB_USERNAME=little_forest
# Single quotes keep literal $, # and spaces in Compose env files.
DB_PASSWORD='replace-with-real-password'
DB_NAME=little_forest
TENCENT_MAP_KEY=
ADMIN_EMAIL=lvyanxiang088@gmail.com
ADMIN_PASSWORD='19970804'

# For a reverse proxy running on the host. See DEPLOYMENT.md for OpenResty in Docker.
ADMIN_BIND_IP=127.0.0.1
ADMIN_PORT=8080
SERVICE_BIND_IP=127.0.0.1
SERVICE_PORT=3001
