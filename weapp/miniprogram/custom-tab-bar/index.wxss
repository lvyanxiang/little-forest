.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 16rpx 32rpx 10rpx;
  background: rgba(255, 255, 255, 0.74);
  -webkit-backdrop-filter: blur(30rpx) saturate(175%);
  backdrop-filter: blur(30rpx) saturate(175%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  border-top: 1rpx solid #E5E6E2;
  box-sizing: border-box;
}

.tab-bar.hidden {
  display: none;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
}

.icon {
  width: 44rpx;
  height: 44rpx;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: 32rpx;
  background: #646660;
  color: #F7F7F5;
  font-size: 18rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.label {
  font-size: 20rpx;
  color: #C9CBC6;
}

.label.on {
  color: #242522;
  font-weight: 500;
}
