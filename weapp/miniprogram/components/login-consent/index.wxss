.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 310; padding: 48rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: rgba(20, 20, 20, .4); }
.dialog { width: 100%; max-height: 85vh; overflow-y: auto; padding: 40rpx; box-sizing: border-box; border-radius: 40rpx; background: #FFFFFF; }
.title { display: block; margin-bottom: 24rpx; text-align: center; font-size: 36rpx; font-weight: 600; color: #242522; }
.description { display: block; font-size: 26rpx; line-height: 1.7; color: #70726D; }
.hint { margin-top: 16rpx; font-size: 24rpx; }
.policy-link { padding: 24rpx 0; text-align: center; text-decoration: underline; font-size: 26rpx; color: #242522; }
.consent { display: flex; align-items: flex-start; padding: 16rpx 0 32rpx; font-size: 24rpx; line-height: 1.6; color: #70726D; }
.check { width: 34rpx; height: 34rpx; margin: 2rpx 16rpx 0 0; flex-shrink: 0; border: 2rpx solid #C9CBC6; border-radius: 8rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.check.on { background: #242522; border-color: #242522; }
.check-mark { width: 14rpx; height: 8rpx; margin-top: -4rpx; border-left: 3rpx solid #FFFFFF; border-bottom: 3rpx solid #FFFFFF; transform: rotate(-45deg); }
.actions { display: flex; gap: 20rpx; }
.button { flex: 1; margin: 0; padding: 0 8rpx; line-height: 80rpx; font-size: 26rpx; border-radius: 20rpx; }
.button::after { border: none; }
.ghost { background: #F7F7F5; color: #242522; }
.solid { background: #242522; color: #F7F7F5; }
.error-text { display: block; margin: -12rpx 0 24rpx; font-size: 24rpx; line-height: 1.5; color: #B87C4C; }
.shake { animation: consent-shake .5s ease; color: #B87C4C; }
.consent.shake .check { border-color: #B87C4C; }
@keyframes consent-shake {
  0%, 100% { transform: translateX(0); }
  16% { transform: translateX(-14rpx); }
  32% { transform: translateX(14rpx); }
  48% { transform: translateX(-10rpx); }
  64% { transform: translateX(10rpx); }
  80% { transform: translateX(-5rpx); }
}
