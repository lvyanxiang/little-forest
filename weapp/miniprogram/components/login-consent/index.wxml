<view wx:if="{{show}}" class="mask" catchtouchmove="noop">
  <view class="dialog" catchtap="noop">
    <text class="title">{{uiText.loginTitle}}</text>
    <text class="description">{{uiText.loginDescription}}</text>
    <text class="description hint">{{uiText.loginHint}}</text>
    <view class="policy-link" bindtap="onOpenPrivacy">{{uiText.privacyLinkText}}</view>
    <view class="consent {{consentShake ? 'shake' : ''}}" bindtap="onToggle" role="checkbox" aria-checked="{{checked}}" aria-label="同意用户隐私保护指引">
      <view class="check {{checked ? 'on' : ''}}"><view wx:if="{{checked}}" class="check-mark"></view></view>
      <text>{{uiText.loginConsentText}}</text>
    </view>
    <text wx:if="{{errorText}}" class="error-text">{{errorText}}</text>
    <view class="actions">
      <button class="button ghost" bindtap="cancel">{{uiText.loginDeclineText}}</button>
      <button class="button solid" bindtap="onAgree">{{uiText.loginAgreeText}}</button>
    </view>
  </view>
</view>
