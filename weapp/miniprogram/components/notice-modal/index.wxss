.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 210;
  background: rgba(30, 58, 30, 0.4);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 86vh;
  background: #FDFAF3;
  border-radius: 48rpx 48rpx 0 0;
  padding: 16rpx 48rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.handle-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 24rpx;
}

.handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #D8CFC4;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1E3A1E;
  margin-bottom: 12rpx;
}

.intro {
  display: block;
  font-size: 24rpx;
  color: #8A7558;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.body {
  flex: 1;
  min-height: 240rpx;
  max-height: 52vh;
}

.heading {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1E3A1E;
  margin-bottom: 20rpx;
}

.item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.num {
  width: 36rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #5C7A3A;
  line-height: 1.6;
}

.item-text {
  flex: 1;
  font-size: 26rpx;
  color: #1E3A1E;
  line-height: 1.65;
}

.foot {
  display: block;
  margin: 12rpx 0 8rpx;
  font-size: 26rpx;
  color: #5C7A3A;
  line-height: 1.6;
}

.remember {
  display: flex;
  align-items: center;
  padding: 28rpx 0 8rpx;
}

.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #C4B49A;
  box-sizing: border-box;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check.on {
  background: #1E3A1E;
  border-color: #1E3A1E;
}

.check-mark {
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #F5EFE0;
  border-bottom: 3rpx solid #F5EFE0;
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

.remember-text {
  font-size: 24rpx;
  color: #8A7558;
}

.agree-btn {
  height: 96rpx;
  border-radius: 32rpx;
  background: #1E3A1E;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.agree-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #F5EFE0;
}

.cancel {
  padding: 24rpx 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-text {
  font-size: 26rpx;
  color: #8A7558;
}
