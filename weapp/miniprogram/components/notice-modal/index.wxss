.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 210;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(17, 19, 17, 0.14);
  animation: mask-in 180ms ease-out both;
}

.modal {
  position: relative;
  width: 100%;
  max-height: 78vh;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: rgba(239, 241, 237, 0.18);
  -webkit-backdrop-filter: blur(52rpx) saturate(170%) brightness(1.03);
  backdrop-filter: blur(52rpx) saturate(170%) brightness(1.03);
  box-shadow: 0 32rpx 90rpx rgba(0, 0, 0, 0.14);
  animation: glass-in 240ms cubic-bezier(0.2, 0.85, 0.25, 1.08) both;
}

.glass-tint {
  position: absolute;
  pointer-events: none;
}

.glass-tint {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.18), rgba(232, 235, 229, 0.05));
}

.modal-content {
  position: relative;
  z-index: 1;
  max-height: 78vh;
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.title {
  display: block;
  margin-bottom: 10rpx;
  color: rgba(31, 33, 30, 0.94);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.intro {
  display: block;
  margin-bottom: 28rpx;
  color: rgba(57, 60, 55, 0.68);
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.body {
  flex: 1;
  min-height: 220rpx;
  max-height: 44vh;
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 94%, transparent 100%);
  mask-image: linear-gradient(180deg, #000 0%, #000 94%, transparent 100%);
}

.heading {
  display: block;
  margin-bottom: 20rpx;
  color: rgba(31, 33, 30, 0.9);
  font-size: 28rpx;
  font-weight: 600;
}

.item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.num {
  width: 38rpx;
  flex-shrink: 0;
  color: rgba(52, 55, 50, 0.62);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.65;
}

.item-text {
  flex: 1;
  color: rgba(28, 30, 27, 0.86);
  font-size: 25rpx;
  line-height: 1.68;
}

.foot {
  display: block;
  margin: 12rpx 0 18rpx;
  color: rgba(52, 55, 50, 0.68);
  font-size: 25rpx;
  line-height: 1.6;
}

.remember {
  display: flex;
  align-items: center;
  padding: 26rpx 0 8rpx;
}

.check {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border: 2rpx solid rgba(67, 70, 64, 0.34);
  border-radius: 10rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check.on {
  border-color: rgba(31, 33, 30, 0.9);
  background: rgba(31, 33, 30, 0.86);
}

.check-mark {
  width: 14rpx;
  height: 8rpx;
  margin-top: -2rpx;
  border-bottom: 3rpx solid #fff;
  border-left: 3rpx solid #fff;
  transform: rotate(-45deg);
}

.remember-text {
  color: rgba(57, 60, 55, 0.7);
  font-size: 24rpx;
}

.agree-btn {
  position: relative;
  height: 94rpx;
  flex-shrink: 0;
  overflow: hidden;
  margin-top: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  -webkit-backdrop-filter: blur(28rpx) saturate(180%);
  backdrop-filter: blur(28rpx) saturate(180%);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 100ms ease, background 100ms ease;
}

.agree-btn-active {
  background: rgba(255, 255, 255, 0.32);
  transform: scale(0.985);
}

.agree-text {
  position: relative;
  z-index: 1;
  color: rgba(28, 30, 27, 0.92);
  font-size: 31rpx;
  font-weight: 600;
}

.cancel {
  padding: 24rpx 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-text {
  color: rgba(57, 60, 55, 0.68);
  font-size: 26rpx;
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes glass-in {
  from {
    opacity: 0;
    transform: scale(0.94) translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}
