<view wx:if="{{show}}" class="mask" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="handle-wrap">
      <view class="handle"></view>
    </view>
    <text class="title serif">预约须知</text>
    <text class="intro">请阅读以下内容。点击「同意并继续」即表示同意全部条款。</text>
    <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
      <text class="heading serif">小森林庇护所注意事项</text>
      <view wx:for="{{items}}" wx:key="*this" class="item">
        <text class="num">{{index + 1}}</text>
        <text class="item-text">{{item}}</text>
      </view>
      <text class="foot">请和我们一样，爱护爱惜这个空间。谢谢。</text>
    </scroll-view>
    <view class="remember" bindtap="onToggleRemember">
      <view class="check {{remember ? 'on' : ''}}">
        <view wx:if="{{remember}}" class="check-mark"></view>
      </view>
      <text class="remember-text">记住选择，下次预约自动同意</text>
    </view>
    <view class="agree-btn" bindtap="onAgree">
      <text class="agree-text serif">同意并继续</text>
    </view>
    <view class="cancel" bindtap="onClose">
      <text class="cancel-text">取消</text>
    </view>
  </view>
</view>
