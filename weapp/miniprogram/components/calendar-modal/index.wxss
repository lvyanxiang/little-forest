.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(20, 20, 20, 0.4);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  padding: 16rpx 0 calc(80rpx + env(safe-area-inset-bottom));
}

.handle-wrap {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 32rpx;
}

.handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #E5E6E2;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 48rpx 40rpx;
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F7F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn.disabled {
  opacity: 0.3;
}

.chevron {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #242522;
  border-left: 4rpx solid #242522;
}

.chevron.left {
  transform: rotate(-45deg);
  margin-left: 6rpx;
}

.chevron.right {
  transform: rotate(135deg);
  margin-right: 6rpx;
}

.month {
  font-size: 32rpx;
  font-weight: 600;
  color: #242522;
}

.week-row,
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx;
}

.week-cell,
.day {
  width: 14.285%;
  text-align: center;
  box-sizing: border-box;
}

.week-cell {
  font-size: 24rpx;
  color: #70726D;
  padding: 8rpx 0 16rpx;
}

.day {
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.day.empty {
  pointer-events: none;
}

.day.sel {
  background: #242522;
}

.day.off {
  opacity: 0.3;
}

.day-num {
  font-size: 28rpx;
  font-weight: 500;
  color: #242522;
}

.day.sel .day-num {
  color: #F7F7F5;
}

.today-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #646660;
  margin-top: 4rpx;
}

.hint {
  display: block;
  text-align: center;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #70726D;
}
