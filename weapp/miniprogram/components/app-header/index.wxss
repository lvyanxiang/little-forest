.header {
  background: #FFFFFF;
  box-sizing: border-box;
}

.header.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  background: transparent;
}

.nav-row {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #242522;
  line-height: 1.2;
}

.logo {
  flex-shrink: 0;
  width: 112rpx;
  height: 64rpx;
}
