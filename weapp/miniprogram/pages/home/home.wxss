.page {
  min-height: 100vh;
  background: #FDFAF3;
  box-sizing: border-box;
}

.hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, #3D5C2D 0%, #1E3A1E 100%);
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(30, 58, 30, 0.2) 0%, rgba(30, 58, 30, 0.72) 100%);
}

.hero-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 48rpx;
}

.hero-en {
  display: block;
  font-size: 22rpx;
  color: #8FAF6B;
  letter-spacing: 0.15em;
  margin-bottom: 8rpx;
}

.hero-title {
  display: flex;
  flex-direction: column;
  font-size: 48rpx;
  font-weight: 600;
  color: #F5EFE0;
  line-height: 1.35;
}

.cta-wrap {
  padding: 40rpx 48rpx;
}

.cta {
  height: 96rpx;
  border-radius: 32rpx;
  background: #1E3A1E;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta:active {
  opacity: 0.88;
}

.cta-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.cta-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #F5EFE0;
}

.section {
  padding: 0 48rpx 48rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E3A1E;
  margin-bottom: 32rpx;
}

.section-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.section-row .section-title {
  margin-bottom: 0;
}

.section-sub {
  font-size: 24rpx;
  color: #5C7A3A;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.feature-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 0 12rpx 24rpx;
}

.feature-card {
  width: 100%;
  box-sizing: border-box;
  background: #F5EFE0;
  border: 1rpx solid #D8CFC4;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  min-height: 100%;
}

.feature-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1E3A1E;
  margin-bottom: 8rpx;
}

.feature-desc {
  display: block;
  font-size: 22rpx;
  color: #8A7558;
  line-height: 1.6;
}

.section-bleed {
  padding-left: 0;
  padding-right: 0;
}

.section-bleed .section-row {
  padding: 0 48rpx;
}

.h-scroll {
  width: 100%;
}

.scene-row {
  display: inline-flex;
  flex-direction: row;
  padding: 0 48rpx;
  box-sizing: content-box;
}

.scene {
  flex-shrink: 0;
  width: 280rpx;
  height: 360rpx;
  margin-right: 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #1E3A1E;
}

.scene:last-child {
  margin-right: 0;
}

.scene-img {
  width: 100%;
  height: 100%;
  display: block;
}

.section-line {
  height: 1rpx;
  margin: 8rpx 48rpx 48rpx;
  background: #D8CFC4;
}

.store {
  margin: 0 48rpx;
  border: 1rpx solid #D8CFC4;
  border-radius: 32rpx;
  overflow: hidden;
}

.store-cover {
  position: relative;
  height: 256rpx;
}

.store-img {
  width: 100%;
  height: 100%;
  display: block;
}

.store-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(30, 58, 30, 0.35);
}

.store-name {
  position: absolute;
  left: 32rpx;
  bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #F5EFE0;
}

.store-info {
  padding: 32rpx;
  background: #F5EFE0;
}

.store-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.store-row:last-child {
  margin-bottom: 0;
}

.store-ico {
  font-size: 28rpx;
  line-height: 1.4;
  margin-right: 16rpx;
}

.store-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8A7558;
  line-height: 1.6;
}

.store-row.link:active .store-text,
.store-row.link:active .store-nav {
  opacity: 0.7;
}

.store-nav {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #5C7A3A;
}

.store-tips {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #D8CFC4;
}

.store-tips-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #1E3A1E;
  margin-bottom: 12rpx;
}

.store-tip {
  display: block;
  font-size: 22rpx;
  color: #8A7558;
  line-height: 1.7;
}
