.page {
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: #ffffff;
}

.canvas {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #ffffff;
  transition: filter 180ms ease, transform 180ms ease;
}

.canvas.is-blurred {
  filter: blur(22rpx) saturate(0.9) brightness(0.96);
  transform: scale(1.04);
}

.hero-image {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.brand-mark {
  position: absolute;
  top: 280rpx;
  right: 56rpx;
  width: 120rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.76);
}

.brand-placeholder {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #242522;
}

.copy {
  position: absolute;
  top: 400rpx;
  right: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #5f615c;
}

.copy-line {
  display: block;
  font-size: 24rpx;
  line-height: 2;
  letter-spacing: 0.04em;
  text-align: right;
  text-shadow: none;
}

.reserve {
  position: absolute;
  right: 56rpx;
  bottom: calc(190rpx + env(safe-area-inset-bottom));
  width: 280rpx;
  height: 80rpx;
  border: 1rpx solid rgba(52, 57, 48, 0.62);
  background: rgba(255, 255, 255, 0.58);
  -webkit-backdrop-filter: blur(24rpx) saturate(150%);
  backdrop-filter: blur(24rpx) saturate(150%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.78), 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reserve:active {
  opacity: 0.72;
}

.reserve-text {
  display: block;
  font-size: 28rpx;
  letter-spacing: 0.22em;
  color: #292e27;
}
