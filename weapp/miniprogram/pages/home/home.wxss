.page {
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: #ffffff;
}

.canvas {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #ffffff;
}

.hero-image {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.wash {
  position: absolute;
  pointer-events: none;
}

.wash-center {
  top: 0;
  right: 0;
  bottom: 0;
  width: 42%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.1) 55%, rgba(255, 255, 255, 0.26));
}

.copy {
  position: absolute;
  top: 230rpx;
  right: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #20211f;
}

.copy-line {
  display: block;
  font-size: 34rpx;
  line-height: 1.9;
  letter-spacing: 0.06em;
  text-align: right;
  text-shadow: 0 1rpx 10rpx rgba(255, 255, 255, 0.58);
}

.reserve {
  position: absolute;
  right: 48rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  min-width: 220rpx;
  padding: 24rpx 30rpx 22rpx;
  border: 1rpx solid rgba(52, 57, 48, 0.62);
  background: rgba(247, 245, 239, 0.76);
  backdrop-filter: blur(10rpx);
  box-sizing: border-box;
}

.reserve:active {
  opacity: 0.72;
}

.reserve-small {
  display: block;
  margin-bottom: 6rpx;
  font-size: 15rpx;
  letter-spacing: 0.16em;
  color: #77796f;
}

.reserve-text {
  display: block;
  font-size: 31rpx;
  letter-spacing: 0.12em;
  color: #292e27;
}

.reserve-line {
  width: 52rpx;
  height: 2rpx;
  margin-top: 14rpx;
  background: #343930;
}
