<view class="page">
  <view class="canvas">
    <image class="hero-image" src="{{heroImage}}" mode="aspectFill" />
    <view class="wash wash-center"></view>
    <view class="copy serif">
      <text wx:for="{{heroLines}}" wx:key="index" class="copy-line">{{item}}</text>
    </view>

    <view class="reserve" bindtap="onReserve">
      <text class="reserve-small">RESERVATION</text>
      <text class="reserve-text serif">立即预约</text>
      <view class="reserve-line"></view>
    </view>
  </view>

  <notice-modal
    show="{{showEntryNotice}}"
    title="到店须知"
    intro="到店前请先阅读以下说明"
    heading="{{store.noticeHeading}}"
    items="{{store.noticeItems}}"
    foot="{{store.noticeFoot}}"
    confirmText="我已知晓"
    showRemember="{{false}}"
    showCancel="{{false}}"
    bind:agree="onDismissNotice"
    bind:close="onDismissNotice"
  />
</view>
