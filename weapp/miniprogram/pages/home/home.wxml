<view class="page">
  <view wx:if="{{!storeReady || storeError}}" class="load-state">
    <text>{{storeLoading ? '正在加载…' : storeError}}</text>
    <button wx:if="{{!storeLoading}}" bindtap="loadStore">重试</button>
  </view>
  <view wx:if="{{storeReady}}" class="canvas {{showEntryNotice ? 'is-blurred' : ''}}">
    <image class="hero-image" src="{{heroImage}}" mode="aspectFill" />
    <image class="brand-mark" src="{{store.brandLogoUrl}}" mode="aspectFill" />
    <view class="copy serif">
      <text wx:for="{{heroLines}}" wx:key="index" class="copy-line">{{item}}</text>
    </view>

    <view class="reserve" bindtap="onReserve">
      <text class="reserve-text serif">{{uiText.homeReserveText}}</text>
    </view>
  </view>

  <notice-modal
    show="{{storeReady && showEntryNotice}}"
    title="{{uiText.homeNoticeTitle}}"
    intro="{{uiText.homeNoticeIntro}}"
    heading="{{store.noticeHeading}}"
    items="{{store.noticeItems}}"
    foot="{{store.noticeFoot}}"
    confirmText="{{uiText.homeNoticeConfirm}}"
    showRemember="{{false}}"
    showCancel="{{false}}"
    bind:agree="onDismissNotice"
    bind:close="onDismissNotice"
  />
</view>
