.page {
  min-height: 100vh;
  background: #FFFFFF;
  box-sizing: border-box;
}

.user-card {
  margin: 24rpx 48rpx 48rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E6E2;
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F1F1EF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #242522;
}

.user-phone {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #70726D;
}

.user-count {
  text-align: right;
  padding-left: 28rpx;
  border-left: 1rpx solid #E5E6E2;
}

.count-num {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #242522;
}

.count-label {
  font-size: 24rpx;
  color: #70726D;
}

.section {
  padding: 0 48rpx 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #242522;
  margin-bottom: 24rpx;
}

.empty {
  border-radius: 32rpx;
  padding: 80rpx 0;
  background: #F7F7F5;
  border: 1rpx dashed #C9CBC6;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.empty:active {
  opacity: 0.85;
}

.empty-text {
  font-size: 28rpx;
  color: #70726D;
}

.up-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.up-card {
  background: #F7F7F5;
  border: 1rpx solid #C9CBC6;
  border-radius: 32rpx;
  padding: 32rpx;
}

.up-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #646660;
}

.status {
  font-size: 24rpx;
  font-weight: 500;
  color: #646660;
}

.up-date {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #242522;
}

.up-slot {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #70726D;
}

.cancel-btn {
  font-size: 24rpx;
  color: #70726D;
  border: 1rpx solid #E5E6E2;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
}

.up-foot {
  padding-top: 24rpx;
  border-top: 1rpx solid #E5E6E2;
  display: flex;
  gap: 64rpx;
}

.meta-k {
  display: block;
  font-size: 20rpx;
  color: #70726D;
  margin-bottom: 4rpx;
}

.meta-v {
  font-size: 24rpx;
  color: #242522;
}

.past-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.past-card {
  background: #F7F7F5;
  border: 1rpx solid #E5E6E2;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  opacity: 0.7;
}

.past-date {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #70726D;
}

.past-slot {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #C9CBC6;
}

.past-tag {
  font-size: 24rpx;
  color: #70726D;
  background: #E5E6E2;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(20, 20, 20, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}

.dialog {
  width: 100%;
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 48rpx;
  box-sizing: border-box;
}

.dialog-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #242522;
  margin-bottom: 16rpx;
}

.dialog-desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #70726D;
  margin-bottom: 48rpx;
}

.dialog-actions {
  display: flex;
  gap: 24rpx;
}

.dialog-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.dialog-btn.ghost {
  background: #F7F7F5;
  border: 1rpx solid #C9CBC6;
  color: #242522;
}

.dialog-btn.solid {
  background: #242522;
  color: #F7F7F5;
}
