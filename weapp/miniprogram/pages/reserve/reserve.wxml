<view class="page {{step === 'pick' ? 'page-pick' : ''}}" style="padding-bottom: {{pageBottom}}px;">
  <view wx:if="{{!storeReady || storeError}}" class="load-state">
    <text>{{storeLoading ? '正在加载…' : storeError}}</text>
    <button wx:if="{{!storeLoading}}" bindtap="bootstrap">重试</button>
  </view>
  <app-header title="{{uiText.reserveTitle}}" />

  <block wx:if="{{storeReady && step === 'pick'}}">
    <scroll-view class="pick-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pick-body">
      <view class="date-head">
        <view class="date-title-row">
          <text class="block-title serif">选择日期</text>
          <text class="block-sub">{{selectedDateText}}</text>
        </view>
        <view class="more-btn {{isQuickDate ? '' : 'on'}}" bindtap="onOpenCalendar">
          <text class="more-text">{{moreDateLabel}}</text>
        </view>
      </view>

      <scroll-view class="date-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="date-row">
          <view
            wx:for="{{quickDates}}"
            wx:key="ts"
            class="date-chip {{item.selected ? 'on' : ''}} {{item.closed ? 'closed' : ''}}"
            data-ts="{{item.ts}}"
            bindtap="onSelectDate"
          >
            <text class="chip-month">{{item.monthLabel}}</text>
            <text class="chip-day serif">{{item.day}}</text>
            <text class="chip-week">{{item.weekday}}</text>
          </view>
          <view class="date-chip dash" bindtap="onOpenCalendar">
            <image class="dash-icon" src="/assets/icon-reserve.svg" mode="aspectFit" />
            <text class="chip-week">日历</text>
          </view>
        </view>
      </scroll-view>

      <view class="divider"></view>

      <view class="slot-head">
        <text class="block-title serif">选择时段</text>
        <text class="block-sub">{{uiText.slotSubtitle}}</text>
      </view>

      <view wx:if="{{dayClosed}}" class="closed-tip">该日闭馆，请选择其他日期</view>
      <view class="slot-list">
        <view
          wx:for="{{slots}}"
          wx:key="id"
          class="slot {{item.isFull ? 'full' : ''}}"
          style="background: {{item.cardBg}}; border-color: {{item.cardBorder}};"
          data-id="{{item.id}}"
          data-full="{{item.isFull}}"
          bindtap="onSelectSlot"
        >
          <view class="slot-top">
            <text class="slot-time serif" style="color: {{item.timeColor}};">{{item.label}}</text>
            <view wx:if="{{item.isSel}}" class="sel-badge">
              <text class="sel-text">已选</text>
            </view>
            <view wx:elif="{{item.isPast}}" class="full-badge">已过时</view>
            <view wx:elif="{{item.isFull}}" class="full-badge">已约满</view>
          </view>
          <view class="occ">
            <view class="occ-row">
              <view class="occ-left">
                <text class="occ-label" style="color: {{item.muted}};">预约人数</text>
                <text class="occ-frac">已约 {{item.booked}}/{{item.max}} 人</text>
              </view>
              <text class="occ-status" style="color: {{item.statusColor}};">{{item.statusLabel}}</text>
            </view>
            <view class="track {{item.isSel ? 'on' : ''}}">
              <view class="fill" style="width: {{item.fillPct}}%; background: {{item.barColor}};"></view>
              <view wx:if="{{item.showShimmer}}" class="shimmer" style="width: {{item.fillPct}}%;"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
    </scroll-view>

    <view class="sticky">
      <text class="sticky-hint {{selectedSlot ? 'on' : ''}}">
        {{selectedSlot ? '已选：' + selectedDateText + ' · ' + selectedSlotLabel : '请选择到店时段'}}
      </text>
      <button class="btn {{selectedSlot ? '' : 'off'}}" bindtap="onNext" loading="{{enteringForm || storeLoading}}" disabled="{{!selectedSlot || enteringForm || storeLoading || storeError}}">
        <text class="btn-text serif">{{enteringForm ? '正在登录…' : '下一步，填写信息'}}</text>
      </button>
    </view>
  </block>

  <view wx:elif="{{step === 'form'}}" class="form-body">
    <view class="back" bindtap="onBackPick">
      <view class="back-chevron"></view>
      <text>返回</text>
    </view>
    <view class="summary">
      <text class="summary-k">预约信息</text>
      <text class="summary-date serif">{{selectedDateText}}</text>
      <text class="summary-slot">{{selectedSlotLabel}}</text>
    </view>
    <view class="field">
      <text class="label">姓名</text>
      <input class="input" maxlength="40" value="{{name}}" placeholder="请输入您的姓名" placeholder-class="ph" bindinput="onNameInput" disabled="{{submitting}}" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" placeholder="请输入您的手机号" placeholder-class="ph" bindinput="onPhoneInput" disabled="{{submitting}}" />
      <button class="wechat-phone" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{gettingPhone}}" disabled="{{gettingPhone || submitting}}">{{gettingPhone ? '正在获取…' : uiText.phoneAuthorizeText}}</button>
      <text wx:if="{{phoneError}}" class="phone-error">{{phoneError}}</text>
    </view>
    <view class="notice">
      <text class="notice-foot">{{uiText.bookingPurposeText}}</text>
      <text class="notice-title serif">到店须知</text>
      <text class="notice-heading">{{noticeHeading}}</text>
      <view wx:for="{{noticeItems}}" wx:key="*this" class="notice-row">
        <text class="notice-no">{{index + 1}}</text>
        <text class="notice-text">{{item}}</text>
      </view>
      <text class="notice-foot">{{noticeFoot}}</text>
      <view
        id="notice-check"
        class="notice-check {{noticeRead ? 'on' : ''}} {{noticeShake ? 'shake' : ''}}"
        bindtap="onToggleNotice"
      >
        <view class="check-box">
          <view wx:if="{{noticeRead}}" class="check-mark"></view>
        </view>
        <text class="check-label">{{uiText.storeNoticeConsentText}}</text>
      </view>
      <view id="privacy-check" class="notice-check {{privacyAgreed ? 'on' : ''}}" bindtap="onTogglePrivacy" role="checkbox" aria-checked="{{privacyAgreed}}" aria-label="同意预约个人信息处理">
        <view class="check-box"><view wx:if="{{privacyAgreed}}" class="check-mark"></view></view>
        <view class="check-label">{{uiText.bookingConsentPrefix}}<text class="policy-link" catchtap="onOpenPrivacy">{{uiText.privacyPolicyName}}</text>{{uiText.bookingConsentSuffix}}</view>
      </view>
    </view>
    <button class="btn {{fieldsReady ? '' : 'off'}}" bindtap="onConfirm" loading="{{submitting}}" disabled="{{submitting}}">
      <text class="btn-text serif">{{submitting ? '正在提交…' : '确认预约'}}</text>
    </button>
  </view>

  <view wx:elif="{{step === 'success'}}" class="success-body">
    <view class="success-logo-wrap">
      <view class="success-logo">
        <image src="{{brandLogoUrl}}" class="success-img" mode="aspectFill" />
      </view>
      <view class="success-ring"></view>
    </view>
    <text class="success-title serif">{{uiText.successTitle}}</text>
    <text class="success-sub">{{uiText.successSubtitle}}</text>
    <view class="success-card">
      <view class="success-grid">
        <view class="sg">
          <text class="sg-k">姓名</text>
          <text class="sg-v">{{name}}</text>
        </view>
        <view class="sg">
          <text class="sg-k">日期</text>
          <text class="sg-v">{{successDate}}</text>
        </view>
        <view class="sg">
          <text class="sg-k">时段</text>
          <text class="sg-v">{{selectedSlotLabel}}</text>
        </view>
      </view>
      <view class="success-foot">
        <text class="success-note">📍 {{storeAddress}} · {{uiText.successAddressHint}}</text>
      </view>
    </view>
    <view class="success-notice">
      <text class="success-notice-title serif">{{uiText.successNoticeTitle}}</text>
      <text wx:for="{{successNoticeLines}}" wx:key="*this" class="success-notice-line">{{item}}</text>
    </view>
    <view class="btn success-btn" bindtap="onReset">
      <text class="btn-text serif">再次预约</text>
    </view>
  </view>

  <calendar-modal
    show="{{showCalendar}}"
    selectedTs="{{selectedTs}}"
    closedWeekdays="{{closedWeekdays}}"
    bookingAdvanceDays="{{bookingAdvanceDays}}"
    bind:select="onCalendarSelect"
    bind:close="onCloseCalendar"
  />
  <login-consent uiText="{{uiText}}" id="login-consent" bindvisibilitychange="onLoginConsentVisibility" />
  <view wx:if="{{showPhonePrompt}}" class="phone-mask" catchtouchmove="noop">
    <view class="phone-dialog" catchtap="noop">
      <text class="phone-title">{{uiText.phonePromptTitle}}</text>
      <text class="phone-description">{{uiText.phonePromptDescription}}</text>
      <view class="phone-actions">
        <button class="phone-button ghost" bindtap="onClosePhonePrompt" disabled="{{gettingPhone}}">{{uiText.phoneManualText}}</button>
        <button class="phone-button solid" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{gettingPhone}}" disabled="{{gettingPhone}}">{{uiText.phoneAuthorizeText}}</button>
      </view>
    </view>
  </view>
  <view wx:if="{{showPrivacy}}" class="phone-mask privacy-mask" catchtouchmove="noop">
    <view class="phone-dialog" catchtap="noop">
      <text class="phone-title">{{uiText.privacyTitle}}</text>
      <text class="phone-description">{{uiText.reservePrivacyDescription}}</text>
      <view class="phone-policy" bindtap="onOpenPrivacy">{{uiText.privacyLinkText}}</view>
      <view class="phone-actions">
        <button class="phone-button ghost" bindtap="onRejectPrivacy">暂不授权</button>
        <button id="agree-reserve-privacy" class="phone-button solid" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacy">同意</button>
      </view>
    </view>
  </view>
</view>
